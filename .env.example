# Clawback — Environment Variables
# Copy to .env and fill in your keys.

# LLM Provider: "anthropic" (default) or "openai"
CLAWBACK_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAWBACK_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (used when CLAWBACK_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
CLAWBACK_OPENAI_MODEL=gpt-4o
